# MongoDB connection string (Atlas or self-hosted). Required — the app throws on startup
# if this is missing. See src/lib/mongoose.ts.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Secret used to sign/verify session JWTs (src/lib/auth.ts). Use a long, random value —
# e.g. `openssl rand -base64 32`. Rotating this invalidates all existing sessions.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of extra origins allowed to call the API cross-origin
# (src/lib/cors.ts). Leave empty for same-origin only (the default — the app serves its
# own frontend and API from the same domain, so this is rarely needed).
ALLOWED_ORIGINS=
