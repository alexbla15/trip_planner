# MongoDB connection string (Atlas or self-hosted). Required — the app throws on startup
# if this is missing. See src/lib/mongoose.ts.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Secret used to sign/verify session JWTs (src/lib/auth.ts). Use a long, random value —
# e.g. `openssl rand -base64 32`. Rotating this invalidates all existing sessions.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of extra origins allowed to call the API cross-origin
# (src/lib/cors.ts). Leave empty for same-origin only (the default — the app serves its
# own frontend and API from the same domain, so this is rarely needed).
ALLOWED_ORIGINS=

# Explicit environment flag (src/lib/isProduction.ts), independent of Next's built-in
# NODE_ENV (which `next build` always sets to "production" regardless of the actual
# deploy target). Set to "development" to unlock dev-only features like the admin
# quick-login button below. Any other value — or leaving this unset — fails closed and
# is treated as production.
NEXT_PUBLIC_APP_ENV=development

# Fixed credentials for the "Continue as Demo User" / "Continue as Admin" quick-login
# buttons on the sign-in page (src/app/api/auth/demo-login/route.ts). The account is
# created on first use if it doesn't already exist. The admin quick-login button (and
# the endpoint's admin path) only works when NEXT_PUBLIC_APP_ENV=development.
DEMO_USER_EMAIL=demo@tripplanner.app
DEMO_USER_PASSWORD=replace-with-a-demo-password
DEMO_ADMIN_EMAIL=admin@tripplanner.app
DEMO_ADMIN_PASSWORD=replace-with-a-demo-password
